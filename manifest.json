
{
  "manifest_version": 3,
  "name": "CodeChef AutoSync",
  "version": "1.0",
  "description": "Save your CodeChef practice solutions to GitHub.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.codechef.com/*",
    "https://codechef.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
